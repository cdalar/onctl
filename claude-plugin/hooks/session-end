#!/usr/bin/env bash
# SessionEnd hook: destroy the box a session-mode /onctl:on created, so
# a session box never outlives its session. Project boxes are left alone.
set -euo pipefail

root="$(cd "$(dirname "$0")/.." && pwd)"
CLAUDE_SESSION_ID="$(jq -r '.session_id // empty')"
export CLAUDE_SESSION_ID
[[ -n "$CLAUDE_SESSION_ID" ]] || exit 0
"$root/bin/onctl-claude" end
